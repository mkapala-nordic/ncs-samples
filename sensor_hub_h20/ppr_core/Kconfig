config APP_PROVIDE_PM_HOOKS
	bool "Application provides PM hooks"
	default y if SOC_NRF54H20_CPUPPR
	select HAS_PM
	select HAS_POWEROFF

config APP_MULTITHREADING
	bool "Application uses multithreading"
	default y

